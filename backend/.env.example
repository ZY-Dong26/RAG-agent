# 仅在 .env 不存在时复制此模板；真实密钥只填写到 .env，不要提交到 Git。
# 大模型服务密钥：用于根据检索内容生成回答，不用于文档解析。
LLM_API_KEY=
# 大模型接口地址：需与密钥所属服务商对应。
LLM_BASE_URL=https://api.deepseek.com/v1
# 回答生成使用的模型名称：需为对应服务商支持的模型。
LLM_MODEL=deepseek-chat
# 百炼 Qwen3.8 默认开启思考；日常问答关闭，其他服务不会收到此专有参数。
LLM_ENABLE_THINKING=false

# 独立裁判模型：仅 scripts/judge.py 使用；可与回答模型来自不同服务商。
JUDGE_LLM_API_KEY=
JUDGE_LLM_BASE_URL=
JUDGE_LLM_MODEL=

# 模型相对路径以 backend/ 为基准，也支持绝对路径。
# 本地向量模型目录：把文本转为向量，用于知识库建索引和查询。
EMBEDDING_MODEL=model/Qwen3-Embedding-0.6B
# 6 GB 显存建议 Embedding 用 CPU，把 GPU 留给重排器；可选 cpu、cuda、auto。
EMBEDDING_DEVICE=cpu
# 本地 BGE 重排模型目录；程序不会自动下载。设 RERANK_ENABLED=false 可暂时跳过重排。
RERANKER_MODEL=model/bge-reranker-v2-m3
RERANK_ENABLED=true
# auto 在有 CUDA 时使用 GPU，否则用 CPU；也可强制 cpu 或 cuda。
RERANK_DEVICE=auto

# MinerU 云端文档解析配置
# MinerU 服务密钥：仅用于云端文档解析，与大模型密钥不同。
MINERU_API_KEY=
# MinerU 官方接口地址：当前客户端只支持该官方协议。
MINERU_BASE_URL=https://mineru.net/api/v4
# 解析模型：可选 vlm 或 pipeline，当前默认使用 vlm。
MINERU_MODEL=vlm
# 文档语言：ch 表示中文。
MINERU_LANGUAGE=ch
# 是否启用图片文字识别：扫描版 PDF 需要开启，填写 true 或 false。
MINERU_OCR=true
# 是否启用公式识别：填写 true 或 false。
MINERU_FORMULA=true
# 是否启用表格识别：填写 true 或 false。
MINERU_TABLE=true
# 单次网络请求的超时时间，单位为秒。
MINERU_TIMEOUT=60
# 查询云端任务状态的间隔，单位为秒。
MINERU_POLL_INTERVAL=5
# 本次轮询的等待预算，单位为秒；超时后保留任务进度，下次可以继续。
MINERU_MAX_WAIT=1800
# 查询和下载最多尝试的次数，包含第一次；创建任务不自动重试。
MINERU_RETRIES=3
# 云端模型更新后，如需重新解析，可主动修改此版本标识，使旧解析缓存失效。
# 解析缓存版本标识：主动修改它会使同一文档使用新缓存，并重新提交解析。
MINERU_CACHE_REVISION=1
