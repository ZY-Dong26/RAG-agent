# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyre/
.hypothesis/

# Virtual environments
.venv/
venv/
env/
ENV/

# Packaging and build outputs
build/
dist/
*.egg-info/
.eggs/
*.egg
pip-wheel-metadata/

# Coverage and test outputs
.coverage
.coverage.*
htmlcov/
coverage.xml
.tox/
.nox/

# Local configuration and secrets
.env
.env.*
!.env.example
*.pem
*.key

# IDE and notebook state
.idea/
.vscode/
.ipynb_checkpoints/

# Local model weights (download separately)
/model/

# Local documents and generated RAG artifacts; retain directory placeholders
/data/raw/*
!/data/raw/.gitkeep
/data/processed/*
!/data/processed/.gitkeep
/vector_db/*
!/vector_db/.gitkeep

# Logs and OS files
*.log
.DS_Store
Thumbs.db
Desktop.ini
