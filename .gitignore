# Python 编译生成的字节码与工具缓存
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyre/
.hypothesis/

# 本地 Python 虚拟环境，不随源码提交
.venv/
venv/
env/
ENV/

# 打包、构建及安装过程中生成的文件
build/
dist/
*.egg-info/
.eggs/
*.egg
pip-wheel-metadata/

# 测试覆盖率报告及自动化测试环境
.coverage
.coverage.*
htmlcov/
coverage.xml
.tox/
.nox/

# 本地配置与密钥；仅允许提交不含真实密钥的示例文件
.env
.env.*
!.env.example
*.pem
*.key

# 编辑器个人配置与交互式笔记本检查点
.idea/
.vscode/
.ipynb_checkpoints/

# 本地模型权重：体积较大，在每台机器上单独准备
/model/

# 原始文档、解析结果与向量索引保留在本地；保留 .gitkeep 以跟踪目录结构
/data/raw/*
!/data/raw/.gitkeep
/data/processed/*
!/data/processed/.gitkeep
/data/vector_db/*
!/data/vector_db/.gitkeep

# 运行日志与操作系统生成的辅助文件
*.log
.DS_Store
Thumbs.db
Desktop.ini

# 评测结果含原始资料、答案与提示词，仅保留本地
/data/outputs/

# 本地项目开发约定，不纳入 Git
/AGENTS.md
